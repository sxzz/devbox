#!/usr/bin/env bash
# Applies repo-managed config before handing over to the upstream entrypoint.
set -euo pipefail

mkdir -p "$HOME" "$CLAUDE_CONFIG_DIR" "$CODEX_HOME"
chown paseo:paseo "$HOME" "$CLAUDE_CONFIG_DIR" "$CODEX_HOME"
gosu paseo /usr/local/bin/devbox-activate

exec /usr/local/bin/paseo-docker-entrypoint "$@"
