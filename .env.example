# Copy to .env (git-ignored) and fill in.
DATA_DIR=$HOME/app/paseo
# Tailscale IP of the host; the daemon and browser desktop are also published on it.
TAILSCALE_IP=
TZ=UTC

# Tailscale auth key for the container's own tailnet node (hostname devbox).
# Only used on first start; create a reusable/non-ephemeral one at
# https://login.tailscale.com/admin/settings/keys, then it can be removed.
TS_AUTHKEY=

# Generate with: openssl rand -base64 24
PASEO_PASSWORD=
BROWSER_PASSWORD=
# Encrypts gog's file keyring (Google OAuth tokens)
GOG_KEYRING_PASSWORD=

# GitHub bot identity for commits (optional until the bot account exists)
DEVBOX_GIT_NAME=
DEVBOX_GIT_EMAIL=
